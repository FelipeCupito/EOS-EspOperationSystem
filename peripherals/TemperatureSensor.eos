#include "eos_dsl_macros.hpp"

peripheral FanController {
    int fanPin;
    SharedVarRO int currentRpm;      // Solo lectura para el usuario
    SharedVar uint8_t powerLevel; // Lectura y escritura

    FanController(int pin)
        : fanPin(pin), currentRpm(0), powerLevel(0) {
        pinMode(fanPin, OUTPUT);
    }

    void internalUpdateRpm(int rpm) { 
        currentRpm = rpm; 
    }

    Service void setPower(uint8_t power) {
        powerLevel = power;
        analogWrite(fanPin, powerLevel);
    }

    Service void emergencyStop() {
        powerLevel = 0;
        analogWrite(fanPin, 0);
    }
};


// =====================
// FanController Generado
// =====================

#include "eos_shared_services.hpp"

class FanController {
public:
    enum class Var : uint16_t { currentRpm, powerLevel };
    enum class Svc : uint8_t { setPower, emergencyStop };

    // ‑‑‑ Alias que heredan la lógica común
    using Shared   = SharedBase< FanController, Var  >;
    using Services = ServicesBase< FanController, Svc >;

    [[nodiscard]] Shared   shared()   noexcept { return Shared{*this}; }
    [[nodiscard]] Services services() noexcept { return Services{*this}; }

    // =====‑‑‑ API interna (igual que antes) ‑‑‑=====
private:
    int      fanPin;
    int      currentRpm;
    uint8_t  powerLevel;

public:
    explicit FanController(int pin)
        : fanPin(pin), currentRpm(0), powerLevel(0) {
        pinMode(fanPin, OUTPUT);
    }

    void internalUpdateRpm(int rpm) { currentRpm = rpm; }

    void setPower(uint8_t power) {
        powerLevel = power;
        analogWrite(fanPin, powerLevel);
    }

    void emergencyStop() {
        powerLevel = 0;
        analogWrite(fanPin, 0);
    }

    // =====‑‑‑‑ PUNTOS DE EXTENSIÓN PARA EL HELPER ‑‑‑‑=====
    template<Var v>
    static decltype(auto) access_shared(FanController&);     // specialisations

    template<Svc s, typename... Args>
    static void invoke_service(FanController&, Args&&...);    // specialisations
};


// -------- Shared::get -------
template<>
inline decltype(auto)
FanController::access_shared<FanController::Var::currentRpm>(FanController& self) {
    return static_cast<const int&>(self.currentRpm);   // RO fuera
}

template<>
inline decltype(auto)
FanController::access_shared<FanController::Var::powerLevel>(FanController& self) {
    return self.powerLevel;                            // RW
}

// -------- Services::call ----
template<>
inline void
FanController::invoke_service<FanController::Svc::setPower>(FanController& self, uint8_t&& power) {
    self.setPower(power);
}

template<>
inline void
FanController::invoke_service<FanController::Svc::emergencyStop>(FanController& self) {
    self.emergencyStop();
}

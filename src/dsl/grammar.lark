// Gramática en Lark con soporte de qualifiers para SharedVar
?start: program

program: peripheral_decl+

// Peripheral con punto y coma al final
peripheral_decl: "peripheral" IDENT "{" body "}" ";"

body: (field_decl | event_enum_decl | service_decl | periodic_decl)*

// Campos: opcional qualifier (SharedVar[RO]), tipo y nombre
FIELD_QUAL: "SharedVarRO" | "SharedVar"
field_decl: FIELD_QUAL? type IDENT ";"
type: /[a-zA-Z_][\w:<>]*/

// Eventos
event_enum_decl: "Events" "{" name_list "}" ";"
name_list: IDENT ("," IDENT)*

// Servicios
service_decl: "Service" type IDENT "(" param_list? ")" ";"
param_list: type IDENT ("," type IDENT)*

// Periodic (se parsea el nombre de la función y se ignora el cuerpo)
periodic_decl: "Periodic" "(" INT ")" function
function: IDENT "(" param_list? ")" "{" /[^}]+/ "}"

%import common.CNAME -> IDENT
%import common.INT
%import common.WS
%ignore WS